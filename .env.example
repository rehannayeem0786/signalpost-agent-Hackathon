# Copy to .env and fill in values. Generate secrets: python scripts/gen_secrets.py

# LLM synthesis (optional - agent runs fully deterministic without these)
GROQ_API_KEY=
OPENROUTER_API_KEY=
# LLM provider preference: groq | openrouter | none
LLM_PROVIDER=none

# Web app secrets (generate with: python scripts/gen_secrets.py)
JWT_SECRET=
CSRF_PEPPER=
SESSION_SECRET=
WEBHOOK_SECRET=

# First-run admin bootstrap (MUST change; app forces rotation on first login)
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_EMAIL=admin@localhost

# Set to 1 when serving over HTTPS (Secure cookie flag)
WEBAPP_SECURE_COOKIES=1

# Frozen company universe used by /research and /refresh
SIGNALPOST_UNIVERSE=data/signalpost-company-universe-2025.jsonl.gz

# CORS allowlist (comma separated origins; empty = same-origin only)
CORS_ALLOW_ORIGINS=

# SSRF allowlist additions (comma separated, optional)
SSRF_EXTRA_ALLOW=
